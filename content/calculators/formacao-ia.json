{
  "name": "Formação de IA",
  "type": "custom",
  "description": "Calculadora para orçamento de Desenho de Onboarding baseado em número de participantes e profundidade",
  "config": {
    "hourlyRate": 150,
    "requiresLeadForm": true,
    "showPDF": true,
    "formula": "9600 * numeroParticipantes * nivelProfundidade",
    "variables": [
      {
        "name": "numeroParticipantes",
        "label": "Quantidade de funcionários",
        "type": "select",
        "defaultValue": "1",
        "options": [
          {
            "value": "1",
            "label": "Até 50 pessoas"
          },
          {
            "value": "1.4",
            "label": "50 - 200 pessoas"
          },
          {
            "value": "1.8",
            "label": "200 - 1.000 pessoas"
          },
          {
            "value": "2.2",
            "label": "Mais de 50 pessoas"
          }
        ]
      },
      {
        "name": "nivelProfundidade",
        "label": "Nível de Profundidade",
        "type": "select",
        "defaultValue": "1",
        "options": [
          {
            "value": "1",
            "label": "Introdutório"
          },
          {
            "value": "1.3",
            "label": "Intermediário"
          },
          {
            "value": "1.6",
            "label": "Avançado"
          }
        ]
      }
    ]
  },
  "display": {
    "title": "Simule seu investimento"
  }
}